<Project>
	<!-- The executables of the GitHub release $(VecturaDBTag) of VecturaDB (Directory.Build.props): for each platform the name of the
	     file in the release and its SHA-256 hash, the digest GitHub gives the file. build/check-release.py checks them against the
	     release, and writes them again for a new tag. -->
	<ItemGroup>
		<VecturaDBExecutable Include="win-x64" Asset="vecturadb-windows-x64.exe" Sha256="31312b1f342e6c5c80a71c8322ba5fe2cef74e5764f19b4c19df33ca5f9759a9" />
		<VecturaDBExecutable Include="linux-x64" Asset="vecturadb-linux-x86_64" Sha256="381d6f8c3e25826b482aa6e81d007453f55bc7fe4d1a37bcc3b6299c2d42972e" />
		<VecturaDBExecutable Include="linux-arm64" Asset="vecturadb-linux-aarch64" Sha256="becc7bf511e68abea9ec78221c3bcba8055e559334282e1621e94e90a03d92cb" />
		<VecturaDBExecutable Include="osx-x64" Asset="vecturadb-macos-x64" Sha256="d1807f8705a678cd9e85adcf01143ca66bf9971e83eaa9af971c10a8c65beac7" />
		<VecturaDBExecutable Include="osx-arm64" Asset="vecturadb-macos-arm64" Sha256="55ffcbdc5b4f707a22839b89d824f30ef8cab90eccc0a9b67117814c4cee01bb" />
	</ItemGroup>
</Project>
